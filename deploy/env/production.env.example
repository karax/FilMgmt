# Copy to ~/.config/filament-command-center/env and keep mode 0600.
# Blank/unset values use the application defaults shown below.

# DATABASE_URL=sqlite+pysqlite:////absolute/path/to/filament.db
# GCODE_UPLOAD_DIRECTORY=/absolute/path/to/uploads/gcode
# PRINT_JOB_MEDIA_DIRECTORY=/absolute/path/to/print-jobs

# Per-file upload limit: 100 MiB.
GCODE_MAX_UPLOAD_BYTES=104857600

# Retain managed uploads for 30 days; 0 makes them immediately eligible.
GCODE_UPLOAD_RETENTION_DAYS=30

# Total managed G-code storage quota: 2 GiB.
GCODE_UPLOAD_MAX_TOTAL_BYTES=2147483648

# Remove abandoned temporary uploads after one hour.
GCODE_UPLOAD_TEMP_STALE_SECONDS=3600

GCODE_UPLOAD_CLEANUP_ENABLED=true
GCODE_UPLOAD_RETENTION_ENABLED=true

# Optional Bambu Lab P1S local read-only MQTT collector. All three identity
# values must be set to enable it. Keep this installed file mode 0600.
# BAMBU_HOST=192.168.1.123
# BAMBU_PORT=8883
# BAMBU_FTPS_PORT=990
# BAMBU_SERIAL=01Pxxxxxxxxxxxx
# BAMBU_ACCESS_CODE=replace-with-the-printer-lan-access-code
# BAMBU_MQTT_TLS=true
# Development only: bounded sanitized normalized payloads at DEBUG log level.
# BAMBU_DEBUG_PAYLOADS=false

# Optional. Default: app checkout's backups/ directory.
# FCC_BACKUP_DIRECTORY=/absolute/path/to/verified-backups

# Operational health URLs for the local services.
FCC_BACKEND_HEALTH_URL=http://127.0.0.1:8000/api/health
FCC_FRONTEND_URL=http://127.0.0.1:8080/
