[Unit]
Description=Filament Command Center API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/filament-command-center/app/backend
EnvironmentFile=-%h/.config/filament-command-center/env
ExecStart=%h/.local/share/filament-command-center/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
