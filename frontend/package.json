{
  "name": "filament-command-center-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:pdf:check && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --maxWorkers=1 --reporter=verbose",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:update": "playwright test -c playwright.config.ts --update-snapshots",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:wave2": "playwright test -c playwright.wave2.config.ts",
    "test:e2e:production": "playwright test -c playwright.production.config.ts",
    "browser:smoke": "npm run test:e2e",
    "browser:doctor": "node scripts/browser-doctor.mjs",
    "browser:screenshot": "node scripts/browser-screenshot.mjs",
    "docs:screenshots": "node scripts/generate-docs-screenshots.mjs",
    "docs:pdf": "node scripts/generate-docs-pdf.mjs",
    "docs:pdf:check": "node scripts/check-manual-pdf.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@zxing/browser": "^0.2.1",
    "chart.js": "^4.5.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.37.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
